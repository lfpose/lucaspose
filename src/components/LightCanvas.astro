---
---

<!-- Labyrinth grid background -->
<canvas id="maze-bg" aria-hidden="true"></canvas>

<!-- HDMI glitch overlay -->
<canvas id="glitch-canvas" aria-hidden="true"></canvas>

<!-- Film grain overlay -->
<canvas id="grain-canvas" aria-hidden="true"></canvas>

<style>
  /* ── Maze canvas — dark mode only ────────────── */
  #maze-bg {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 0;
  }

  /* ── Glitch + grain ──────────────────────────── */
  #glitch-canvas {
    position: fixed;
    inset: 0;
    width: 100vw;
    height: 100vh;
    pointer-events: none;
    z-index: 2;
  }

  #grain-canvas {
    position: fixed;
    inset: 0;
    width: 100vw;
    height: 100vh;
    pointer-events: none;
    z-index: 150;
  }
  :root[data-theme='dark'] #grain-canvas {
    opacity: 0.035;
    mix-blend-mode: overlay;
  }
  :root:not([data-theme='dark']) #grain-canvas {
    opacity: 0.04;
    mix-blend-mode: multiply;
  }
</style>

<script>
  function isDark(): boolean {
    return document.documentElement.getAttribute('data-theme') === 'dark';
  }

  // ── Labyrinth grid ───────────────────────────
  const cvs = document.getElementById('maze-bg') as HTMLCanvasElement;
  const ctx = cvs.getContext('2d')!;

  const CELL = 52;        // grid spacing
  const R_CIRCLE = 4.5;   // hollow circle radius
  const R_DOT = 1.5;      // filled dot radius
  const GAP = 9;          // line endpoint distance from node center
  const WALKERS = 6;
  const DECAY = 0.94;           // intensity fade per tick — trails clear behind cursor
  const GROW_EASE = 0.22;       // ease-out toward full length
  const SHRINK_EASE = 0.20;     // ease-out back to 0
  const SHRINK_AT = 0.5;        // start shrinking sooner so trails clear faster
  // phase: 0 = growing, 1 = live, 2 = shrinking

  let cols = 0, rows = 0;
  let edgesH: Float32Array; // intensity 0..1 — edgesH[r*cols + c] = edge from (r,c) to (r,c+1)
  let edgesV: Float32Array; // intensity 0..1
  let lenH:   Float32Array; // visible length 0..1, grows from chosen end
  let lenV:   Float32Array;
  let phaseH: Uint8Array;   // 0/1/2 (growing/live/shrinking)
  let phaseV: Uint8Array;
  let dirH:   Uint8Array;   // 0 = grew from left node, 1 = from right
  let dirV:   Uint8Array;   // 0 = grew from top node, 1 = from bottom

  // Mouse — smoothed so walker bias / glow don't feel jumpy
  let mouseTargetX = -9999, mouseTargetY = -9999;
  let mouseX = -9999, mouseY = -9999;
  let lastSpawnTime = 0;
  window.addEventListener('mousemove', (e) => {
    mouseTargetX = e.clientX + window.scrollX;
    mouseTargetY = e.clientY + window.scrollY;
    if (mouseX < 0) { mouseX = mouseTargetX; mouseY = mouseTargetY; }
    // Spawn a walker at cursor occasionally — visible mouse-move feedback
    const now = performance.now();
    if (now - lastSpawnTime > 250 && cols > 0) {
      const r = Math.max(0, Math.min(rows - 1, Math.round(mouseTargetY / CELL)));
      const c = Math.max(0, Math.min(cols - 1, Math.round(mouseTargetX / CELL)));
      walkers.push({ r, c, lastDir: Math.floor(Math.random() * 4), life: 25 });
      lastSpawnTime = now;
    }
  });

  function resize() {
    cvs.width  = window.innerWidth;
    cvs.height = Math.max(
      document.documentElement.scrollHeight,
      document.body.scrollHeight,
      document.body.offsetHeight,
      window.innerHeight,
    );
    cols = Math.ceil(cvs.width  / CELL) + 1;
    rows = Math.ceil(cvs.height / CELL) + 1;
    const N = rows * cols;
    edgesH = new Float32Array(N);
    edgesV = new Float32Array(N);
    lenH   = new Float32Array(N);
    lenV   = new Float32Array(N);
    phaseH = new Uint8Array(N);
    phaseV = new Uint8Array(N);
    dirH   = new Uint8Array(N);
    dirV   = new Uint8Array(N);
  }

  // Walkers — biased random walk to make recognisable corridors
  type Walker = { r: number; c: number; lastDir: number; life: number };
  const walkers: Walker[] = [];

  function spawnWalker(): Walker {
    return {
      r: Math.floor(Math.random() * rows),
      c: Math.floor(Math.random() * cols),
      lastDir: Math.floor(Math.random() * 4),
      life: 80 + Math.floor(Math.random() * 80),
    };
  }

  // 0=up, 1=right, 2=down, 3=left
  const DR = [-1, 0, 1, 0];
  const DC = [0, 1, 0, -1];

  function stepWalker(w: Walker) {
    let dir;
    // Strong bias toward mouse if it's been seen; otherwise default behaviour
    if (mouseX > 0 && Math.random() < 0.55) {
      const wx = w.c * CELL, wy = w.r * CELL;
      const dx = mouseX - wx, dy = mouseY - wy;
      if (Math.abs(dx) > Math.abs(dy)) dir = dx > 0 ? 1 : 3;
      else                              dir = dy > 0 ? 2 : 0;
    } else if (Math.random() < 0.6) {
      dir = w.lastDir;
    } else {
      dir = (w.lastDir + (Math.random() < 0.5 ? 1 : 3)) % 4;
    }
    const nr = w.r + DR[dir];
    const nc = w.c + DC[dir];
    if (nr < 0 || nr >= rows || nc < 0 || nc >= cols) {
      // bounce: pick a new direction next tick
      w.lastDir = (w.lastDir + 2) % 4;
      return;
    }
    // Light up the edge between (w.r, w.c) and (nr, nc).
    // dir tells us which node the walker came FROM — that's the dot the line sprouts from.
    let isH: boolean, idx: number, fromStart: boolean;
    if (dir === 1)      { isH = true;  idx = w.r * cols + w.c; fromStart = true;  }
    else if (dir === 3) { isH = true;  idx = w.r * cols + nc;  fromStart = false; }
    else if (dir === 2) { isH = false; idx = w.r * cols + w.c; fromStart = true;  }
    else                { isH = false; idx = nr  * cols + w.c; fromStart = false; }
    triggerEdge(isH, idx, fromStart);

    w.r = nr; w.c = nc;
    w.lastDir = dir;
    w.life--;
  }

  function triggerEdge(isH: boolean, idx: number, fromStart: boolean) {
    const ints = isH ? edgesH : edgesV;
    const lens = isH ? lenH   : lenV;
    const phs  = isH ? phaseH : phaseV;
    const dirs = isH ? dirH   : dirV;

    if (ints[idx] < 0.05) {
      // Brand-new edge — start growing from the origin dot
      ints[idx] = 1;
      lens[idx] = 0.04;
      phs[idx]  = 0;
      dirs[idx] = fromStart ? 0 : 1;
    } else {
      // Already visible — refresh intensity and resolve phase
      ints[idx] = 1;
      if (phs[idx] === 2) {
        // Was shrinking — restart growth from current length so it doesn't snap
        phs[idx] = 0;
      }
      // If growing or live, leave length alone; growth/decay continues naturally
    }
  }

  function updateWalkers() {
    for (let i = walkers.length - 1; i >= 0; i--) {
      stepWalker(walkers[i]);
      if (walkers[i].life <= 0) walkers.splice(i, 1);
    }
    while (walkers.length < WALKERS) walkers.push(spawnWalker());
  }

  function updateEdges() {
    const N = edgesH.length;
    for (let i = 0; i < N; i++) {
      // Horizontal
      if (edgesH[i] > 0.0015 || lenH[i] > 0.0015) {
        const ph = phaseH[i];
        if (ph === 0) {
          lenH[i] += (1 - lenH[i]) * GROW_EASE;
          if (lenH[i] > 0.985) { lenH[i] = 1; phaseH[i] = 1; }
        } else if (ph === 1) {
          edgesH[i] *= DECAY;
          if (edgesH[i] < SHRINK_AT) phaseH[i] = 2;
        } else {
          lenH[i]   += (0 - lenH[i]) * SHRINK_EASE;
          edgesH[i] *= DECAY;
          if (lenH[i] < 0.018) {
            lenH[i] = 0; edgesH[i] = 0; phaseH[i] = 0;
          }
        }
      }
      // Vertical
      if (edgesV[i] > 0.0015 || lenV[i] > 0.0015) {
        const ph = phaseV[i];
        if (ph === 0) {
          lenV[i] += (1 - lenV[i]) * GROW_EASE;
          if (lenV[i] > 0.985) { lenV[i] = 1; phaseV[i] = 1; }
        } else if (ph === 1) {
          edgesV[i] *= DECAY;
          if (edgesV[i] < SHRINK_AT) phaseV[i] = 2;
        } else {
          lenV[i]   += (0 - lenV[i]) * SHRINK_EASE;
          edgesV[i] *= DECAY;
          if (lenV[i] < 0.018) {
            lenV[i] = 0; edgesV[i] = 0; phaseV[i] = 0;
          }
        }
      }
    }
  }

  // De Casteljau split — render only the [0..t] portion (fromStart=true)
  // or the [1-t..1] portion (fromStart=false) of a quadratic Bezier.
  function drawPartialQuad(
    p0x: number, p0y: number,
    p1x: number, p1y: number,
    p2x: number, p2y: number,
    t: number, fromStart: boolean,
  ) {
    if (t >= 0.995) {
      ctx.moveTo(p0x, p0y);
      ctx.quadraticCurveTo(p1x, p1y, p2x, p2y);
      return;
    }
    if (fromStart) {
      const np1x = p0x + t * (p1x - p0x);
      const np1y = p0y + t * (p1y - p0y);
      const u = 1 - t;
      const np2x = u*u*p0x + 2*u*t*p1x + t*t*p2x;
      const np2y = u*u*p0y + 2*u*t*p1y + t*t*p2y;
      ctx.moveTo(p0x, p0y);
      ctx.quadraticCurveTo(np1x, np1y, np2x, np2y);
    } else {
      const s = 1 - t; // start parameter — render from s..1
      const u = 1 - s;
      const np0x = s*s*p0x + 2*s*u*p1x + u*u*p2x;
      const np0y = s*s*p0y + 2*s*u*p1y + u*u*p2y;
      const np1x = p1x + u * (p2x - p1x);
      const np1y = p1y + u * (p2y - p1y);
      ctx.moveTo(np0x, np0y);
      ctx.quadraticCurveTo(np1x, np1y, p2x, p2y);
    }
  }

  // Ink colour is theme-aware: red for dark, forest-green for light (monochrome each)
  function ink(): string {
    return isDark() ? '220,40,50' : '14,36,23';
  }
  const GLOW_R = 340; // halo radius for mouse glow

  function nodeGlow(x: number, y: number): number {
    if (mouseX < 0) return 0;
    const dx = x - mouseX, dy = y - mouseY;
    const d = Math.sqrt(dx*dx + dy*dy);
    if (d > GLOW_R) return 0;
    const t = 1 - d / GLOW_R;
    return t * t * 0.85; // softer falloff, stronger peak
  }

  // Footer planet acts as a star — pulls nearby grid points toward it like a gravity well.
  // Peak bend at LENS_R, smooth falloff on both sides, exponential damping past LENS_FAR.
  // Lens shape: bell curve peaks at r=LENS_R, exponential damping past LENS_FAR.
  // Tuned for strong pull right at the planet, quick falloff after that.
  const LENS_R = 70;
  const LENS_MAX = 80;
  const LENS_FAR = 160;
  let lensX = -9999, lensY = -9999;
  function updateLensCenter() {
    // Read from .planet-small (the fixed canvas) so the lens follows the planet's
    // visible position as the user scrolls.
    const el = document.querySelector<HTMLElement>('.planet-small');
    if (!el) { lensX = -9999; return; }
    const rect = el.getBoundingClientRect();
    lensX = rect.left + rect.width / 2 + window.scrollX;
    lensY = rect.top  + rect.height / 2 + window.scrollY;
  }
  const LENS_CUTOFF2 = 600 * 600;
  function lens(x: number, y: number): [number, number] {
    if (lensX < 0) return [x, y];
    const dx = x - lensX, dy = y - lensY;
    const r2 = dx*dx + dy*dy;
    if (r2 > LENS_CUTOFF2) return [x, y]; // far from planet — skip costly math
    const r = Math.sqrt(r2);
    if (r < 0.5) return [x, y];
    const disp = (2 * LENS_R * LENS_MAX * r) / (r2 + LENS_R * LENS_R);
    const d = disp * Math.exp(-r / LENS_FAR);
    return [x - (dx / r) * d, y - (dy / r) * d];
  }

  // Per-theme subtlety: dark stays a bit more present, light is whisper-quiet
  function subtle(): number { return isDark() ? 0.85 : 0.35; }

  // Deterministic per-edge bow offset for curvature — gives the maze a hand-drawn feel
  const BOW = 5;
  function bowH(r: number, c: number): number {
    return Math.sin(r * 12.9898 + c * 78.233) * BOW;
  }
  function bowV(r: number, c: number): number {
    return Math.sin(r * 39.346 + c * 11.135) * BOW;
  }

  function render() {
    ctx.clearRect(0, 0, cvs.width, cvs.height);
    const RGB = ink();
    const S = subtle();

    // Nodes — hollow circle + filled dot. Brighter near cursor, lensed by mouse-star.
    ctx.lineWidth = 1;
    for (let r = 0; r < rows; r++) {
      for (let c = 0; c < cols; c++) {
        const x = c * CELL, y = r * CELL;
        const g = nodeGlow(x, y);
        const [lx, ly] = lens(x, y);
        ctx.strokeStyle = `rgba(${RGB},${(0.16 + g * 0.4) * S})`;
        ctx.beginPath();
        ctx.arc(lx, ly, R_CIRCLE, 0, Math.PI * 2);
        ctx.stroke();
        ctx.fillStyle = `rgba(${RGB},${(0.45 + g * 0.5) * S})`;
        ctx.beginPath();
        ctx.arc(lx, ly, R_DOT, 0, Math.PI * 2);
        ctx.fill();
      }
    }

    // Edges — gently curved, gentle flicker, glow boost near cursor.
    // Each edge has a phase-driven length so it grows from a dot, lives, then shrinks back.
    ctx.lineCap = 'round';
    ctx.lineWidth = 1.4;
    for (let r = 0; r < rows; r++) {
      for (let c = 0; c < cols; c++) {
        const x = c * CELL, y = r * CELL;
        const idx = r * cols + c;

        const h = edgesH[idx], lh = lenH[idx];
        if (h > 0.04 && lh > 0.015 && c < cols - 1) {
          const g = nodeGlow(x + CELL / 2, y);
          ctx.strokeStyle = `rgba(${RGB},${Math.min(1, (h * 0.85 + g * 0.4) * S)})`;
          const [p0x, p0y] = lens(x + GAP,        y);
          const [p1x, p1y] = lens(x + CELL / 2,   y + bowH(r, c));
          const [p2x, p2y] = lens(x + CELL - GAP, y);
          ctx.beginPath();
          drawPartialQuad(
            p0x, p0y, p1x, p1y, p2x, p2y,
            lh, dirH[idx] === 0,
          );
          ctx.stroke();
        }

        const v = edgesV[idx], lv = lenV[idx];
        if (v > 0.04 && lv > 0.015 && r < rows - 1) {
          const g = nodeGlow(x, y + CELL / 2);
          ctx.strokeStyle = `rgba(${RGB},${Math.min(1, (v * 0.85 + g * 0.4) * S)})`;
          const [p0x, p0y] = lens(x,                y + GAP);
          const [p1x, p1y] = lens(x + bowV(r, c),   y + CELL / 2);
          const [p2x, p2y] = lens(x,                y + CELL - GAP);
          ctx.beginPath();
          drawPartialQuad(
            p0x, p0y, p1x, p1y, p2x, p2y,
            lv, dirV[idx] === 0,
          );
          ctx.stroke();
        }
      }
    }

    // Walkers — a single small dim point. No halo, no pulse, no random.
    for (let i = 0; i < walkers.length; i++) {
      const w = walkers[i];
      const [wx, wy] = lens(w.c * CELL, w.r * CELL);
      const a = Math.max(0, Math.min(1, w.life / 80));
      ctx.fillStyle = `rgba(${RGB},${0.55 * S * a})`;
      ctx.beginPath(); ctx.arc(wx, wy, 1.8, 0, Math.PI * 2); ctx.fill();
    }
  }

  function tick() {
    // Smooth the mouse position toward target so glow & walker-bias don't snap
    if (mouseTargetX > 0) {
      mouseX += (mouseTargetX - mouseX) * 0.20;
      mouseY += (mouseTargetY - mouseY) * 0.20;
    }
    updateLensCenter();
    updateWalkers();
    updateEdges();
    render();
    setTimeout(tick, 55); // ~18fps — calmer, lower CPU
  }

  resize();
  window.addEventListener('resize', resize);
  window.addEventListener('load', resize);
  new ResizeObserver(resize).observe(document.body);
  for (let i = 0; i < WALKERS; i++) walkers.push(spawnWalker());
  tick();

  // ── HDMI glitch effect ───────────────────────
  const glitchCvs = document.getElementById('glitch-canvas') as HTMLCanvasElement;
  const glitchCtx = glitchCvs.getContext('2d')!;

  const GLITCH_DURATION = 100;
  const BASE_GLITCH_CHANCE = 0.01;
  const MAX_GLITCH_CHANCE = 0.3;
  const FREQUENCY_GROWTH_TIME = 60000;

  interface Glitch { x: number; y: number; end: number; }
  const activeGlitches: Glitch[] = [];
  const startTime = performance.now();

  function getGlitchColor(): string { return isDark() ? '#00CCCC' : '#008B8B'; }
  function getCurrentGlitchChance(): number {
    const elapsed = performance.now() - startTime;
    return BASE_GLITCH_CHANCE + (MAX_GLITCH_CHANCE - BASE_GLITCH_CHANCE) * Math.min(1, elapsed / FREQUENCY_GROWTH_TIME);
  }
  function renderGlitches(): void {
    const now = performance.now();
    for (let i = activeGlitches.length - 1; i >= 0; i--) {
      if (now >= activeGlitches[i].end) activeGlitches.splice(i, 1);
    }
    glitchCtx.clearRect(0, 0, glitchCvs.width, glitchCvs.height);
    glitchCtx.fillStyle = getGlitchColor();
    for (const g of activeGlitches) {
      glitchCtx.fillRect(g.x + (Math.random() - 0.5) * 2, g.y + (Math.random() - 0.5) * 2, 2, 2);
    }
  }
  function resizeGlitch() { glitchCvs.width = window.innerWidth; glitchCvs.height = window.innerHeight; }
  resizeGlitch();
  window.addEventListener('resize', resizeGlitch);
  function tickGlitch(): void {
    if (Math.random() < getCurrentGlitchChance()) {
      activeGlitches.push({ x: Math.random() * window.innerWidth, y: Math.random() * window.innerHeight, end: performance.now() + GLITCH_DURATION });
    }
    renderGlitches();
    requestAnimationFrame(tickGlitch);
  }
  tickGlitch();

  // ── Film grain overlay ───────────────────────
  const grainCvs = document.getElementById('grain-canvas') as HTMLCanvasElement;
  const grainCtx = grainCvs.getContext('2d')!;

  const BUF = 512;
  const buf = document.createElement('canvas');
  buf.width = buf.height = BUF;
  const bCtx = buf.getContext('2d')!;
  const img = bCtx.createImageData(BUF, BUF);

  function resizeGrain() { grainCvs.width = window.innerWidth; grainCvs.height = window.innerHeight; }
  resizeGrain();
  window.addEventListener('resize', resizeGrain);

  function tickGrain() {
    const d = img.data;
    for (let i = 0; i < d.length; i += 4) {
      const v = (Math.random() * 255) | 0;
      d[i] = d[i+1] = d[i+2] = v;
      d[i+3] = 255;
    }
    bCtx.putImageData(img, 0, 0);
    grainCtx.drawImage(buf, 0, 0, grainCvs.width, grainCvs.height);
    setTimeout(tickGrain, 80);
  }
  tickGrain();
</script>
