---
const EMAIL = 'posemerani@gmail.com';
const FILLER_POOL = 'abcdefghijklmnopqrstuvwxyz0123456789';
const COLS = 15;
const ROWS = 8;
const E_ROW_MIN = 3, E_ROW_MAX = 6;
const E_COL_MIN = 6, E_COL_MAX = 10;

type Cell = { char: string; row: number; col: number; on: boolean };
const cells: Cell[] = [];
let emailIdx = 0;

for (let row = 1; row <= ROWS; row++) {
  for (let col = 1; col <= COLS; col++) {
    const inMiddle = row >= E_ROW_MIN && row <= E_ROW_MAX
                  && col >= E_COL_MIN && col <= E_COL_MAX;
    if (inMiddle && emailIdx < EMAIL.length) {
      cells.push({ char: EMAIL[emailIdx], row, col, on: true });
      emailIdx++;
    } else {
      cells.push({
        char: FILLER_POOL[Math.floor(Math.random() * FILLER_POOL.length)],
        row, col,
        on: false,
      });
    }
  }
}

// Shuffle DOM order so HTML scrapers see jumbled text
const shuffled = [...cells].sort(() => Math.random() - 0.5);
---

<div class="mail-grid" aria-label="Email puzzle">
  {shuffled.map((cell) => (
    <span
      class:list={['mc', cell.on ? 'mc-on' : 'mc-off']}
      style={`grid-row:${cell.row};grid-column:${cell.col}`}
      data-final={cell.char}
    >
      <span class="mc-face">{cell.char}</span>
    </span>
  ))}
</div>

<style>
  .mail-grid {
    display: grid;
    grid-template-columns: repeat(15, 1fr);
    grid-auto-rows: 1fr;
    gap: 3px;
    font-family: 'JetBrains Mono', monospace;
    margin: 0.4rem 0 0.6rem;
    user-select: none;
    width: 100%;
    font-size: clamp(9px, 1.4vw, 16px);
    position: relative;
    isolation: isolate;
  }
  /* Single blur pane behind ALL cells — one GPU layer instead of 100. */
  .mail-grid::before {
    content: '';
    position: absolute;
    inset: -2px;
    backdrop-filter: blur(8px) saturate(1.15);
    -webkit-backdrop-filter: blur(8px) saturate(1.15);
    border-radius: 4px;
    pointer-events: none;
    z-index: 0;
  }
  /* The cell itself is a stable square hover zone — never transforms.
     Listeners attach here; the inner .mc-face does the visual flip. */
  .mc {
    width: 100%;
    aspect-ratio: 1 / 1;
    position: relative;
    z-index: 1;
  }
  .mc-face {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
    border: 1px solid var(--rule);
    border-radius: 2px;
    line-height: 1;
    transition: transform 220ms cubic-bezier(0.4, 0, 0.6, 1);
    transform-origin: center;
    backface-visibility: hidden;
    pointer-events: none; /* hover lives on parent .mc, not on this flipping element */
  }
  /* Per-cell perspective so each flip rotates around its own axis — no center bias. */
  .mc.mc-flipping .mc-face {
    transform: perspective(240px) rotateX(90deg);
  }

  /* Email-letter cells: glass tile, contrast inverted vs page bg.
     Dark mode → bright tile / dark text. Light mode → dark tile / bright text. */
  .mc-on .mc-face {
    color: rgba(20, 22, 28, 0.96);
    background: rgba(245, 245, 250, 0.78);
    backdrop-filter: blur(4px) saturate(1.15);
    -webkit-backdrop-filter: blur(4px) saturate(1.15);
    border-color: rgba(255, 255, 255, 0.55);
    font-weight: 700;
  }
  :root:not([data-theme='dark']) .mc-on .mc-face {
    color: rgba(255, 255, 255, 0.97);
    background: rgba(8, 10, 14, 0.78);
    border-color: rgba(0, 0, 0, 0.4);
  }

  /* ── Glass filler cells ──────────────────────────────────────────
     Real transparent glass: just the backdrop-blur + a faint bevel.
     No fill, no decorative gradients. What's behind shows through.
  */
  .mc-off .mc-face {
    color: var(--fg-muted);
    background: transparent;
    border-color: rgba(255, 255, 255, 0.10);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.14),
      inset 0 -1px 0 rgba(0, 0, 0, 0.18);
  }

  /* Light mode — bevel inverts since the bg is bright */
  :root:not([data-theme='dark']) .mc-off .mc-face {
    background: transparent;
    border-color: rgba(14, 36, 23, 0.14);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.55),
      inset 0 -1px 0 rgba(14, 36, 23, 0.14);
  }

  @media (prefers-reduced-motion: reduce) {
    .mc { transition: none; }
    .mc.mc-flipping { transform: none; }
  }
</style>

<script>
  // Solari split-flap board: each cell does ONE flip per scheduled event.
  //   tilt 0deg → 90deg (220ms, edge-on / invisible) → swap glyph → tilt 90deg → 0deg (220ms)
  // Email cells (mc-on) only toggle case so the address stays readable.
  // Filler cells (mc-off) alternate between their final glyph and a random char.
  const POOL = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789@.';
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const HALF_FLIP_MS = 220;

  function delay(ms: number): Promise<void> {
    return new Promise((r) => setTimeout(r, ms));
  }

  function getFace(el: HTMLElement): HTMLElement | null {
    return el.querySelector<HTMLElement>('.mc-face');
  }

  async function flipOnce(el: HTMLElement, target: string): Promise<void> {
    el.classList.add('mc-flipping');
    await delay(HALF_FLIP_MS);     // wait for tilt-down (face edge-on, invisible)
    const face = getFace(el);
    if (face) face.textContent = target;
    el.classList.remove('mc-flipping');
    await delay(HALF_FLIP_MS);     // wait for tilt-back
  }

  function pickTarget(el: HTMLElement): string {
    const face = getFace(el);
    const current = face?.textContent ?? '';
    const final = el.dataset.final ?? '';
    if (el.classList.contains('mc-on')) {
      // Email cell — letter stays, toggle case. @ / . have no case so stay put.
      const lower = current.toLowerCase();
      const upper = current.toUpperCase();
      if (lower === upper) return current;
      return current === lower ? upper : lower;
    }
    // Filler — alternate between final and a random char from POOL
    return current === final
      ? POOL[Math.floor(Math.random() * POOL.length)]
      : final;
  }

  // One flip per real enter→leave cycle. Per-cell state machine so the phantom
  // mouseleave that fires when the cell rotates edge-on doesn't trigger another flip
  // (the cell stays "spent" until the cursor genuinely leaves and re-enters).
  type CellState = 'ready' | 'spent';
  const cellState = new WeakMap<HTMLElement, CellState>();

  if (!reduced) {
    document.querySelectorAll<HTMLElement>('.mail-grid .mc').forEach((el) => {
      cellState.set(el, 'ready');

      el.addEventListener('mouseenter', async () => {
        if (cellState.get(el) !== 'ready') return;
        cellState.set(el, 'spent');
        await flipOnce(el, pickTarget(el));
        // Stay 'spent' until a real mouseleave resets us. pointer-events: none
        // during the flip suppresses the phantom leave that would otherwise fire.
      });

      el.addEventListener('mouseleave', () => {
        cellState.set(el, 'ready');
      });
    });
  }
</script>
